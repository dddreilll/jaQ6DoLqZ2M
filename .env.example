# This store's code — determines the queue name (q.store.<code>) and the
# store-scoped binding. Must be loaded before controllers are imported
# (main.ts does `import 'dotenv/config'` first — keep it that way).
STORE_CODE=SAMPLE01

# CDH RabbitMQ connection (local fusion-cdh-api docker-compose default)
CDH_RABBITMQ_URL=amqp://admin:admin123@localhost:5674

# Where applied datasets are persisted (JSON files, one per dataset type)
DATA_DIR=./data
