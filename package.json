{
  "name": "fusion-cdh-store",
  "version": "0.1.0",
  "description": "Sample store app consuming CDH data-sync datasets with the official NestJS RabbitMQ transport (see fusion-cdh-api/docs/store-consumer-rmq-guide.md)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^22.10.7",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
